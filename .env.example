# ===================================================================
# Конфигурация для Regulatory RAG
# ===================================================================
# Скопируйте этот файл в .env и заполните секретами.
# Остальные параметры имеют дефолты в config/settings.py.

# -------------------------------------------------------------------
# API Keys
# -------------------------------------------------------------------

# LLM — нужен ключ того провайдера, который указан в SIMPLE/COMPLEX_LLM_PROVIDER
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE       # https://aistudio.google.com/apikey

# Эмбеддинги — нужен ключ того провайдера, который указан в EMBEDDING_PROVIDER
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE           # https://platform.openai.com/api-keys

# -------------------------------------------------------------------
# Оверайды дефолтов (менять при необходимости)
# -------------------------------------------------------------------

# Модели — по умолчанию: gemini-2.5-flash / gemini-3-flash-preview
# SIMPLE_LLM_PROVIDER=deepseek
# SIMPLE_MODEL_NAME=deepseek-chat
# COMPLEX_LLM_PROVIDER=gemini
# COMPLEX_MODEL_NAME=gemini-3-flash-preview

# V7 graph (по умолчанию: false)
USE_V7_GRAPH=true

# -------------------------------------------------------------------
# LangSmith (опционально)
# -------------------------------------------------------------------
# LANGSMITH_API_KEY=YOUR_LANGSMITH_KEY_HERE
# LANGSMITH_TRACING_V2=true
# LANGSMITH_PROJECT=regulatory-rag

# -------------------------------------------------------------------
# V7 config overrides (по умолчанию в src/v7/config.py)
# -------------------------------------------------------------------
# V7_DOMAIN_GATE_THRESHOLD=0.25
# V8_ENABLE_EVIDENCE_ASSESS=true
# V8_ENABLE_MULTI_QUERY=true
