# ===================================================================
# Конфигурация для Regulatory RAG
# ===================================================================
# Скопируйте этот файл в .env и заполните секретами.
# Остальные параметры имеют дефолты в config/settings.py и src/v7/config.py.

# -------------------------------------------------------------------
# API Keys
# -------------------------------------------------------------------

# Витринный дефолт: simple- и complex-путь — OpenRouter
# (deepseek/deepseek-v4.1-flash), эмбеддинги и судья — OpenAI. Нужны оба ключа ниже.
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE           # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE   # https://openrouter.ai/keys

# Нужен, только если переключить SIMPLE/COMPLEX_LLM_PROVIDER на gemini.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE     # https://aistudio.google.com/apikey
# Нужен, только если провайдер — deepseek.
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY_HERE

# -------------------------------------------------------------------
# Оверайды дефолтов (менять при необходимости)
# -------------------------------------------------------------------

# Путь к ChromaDB (по умолчанию: ./chroma_db)
# CHROMA_DB_PATH=./chroma_db
# Отдельная база режима «Общая нормативная база» на едином экране.
# GENERIC_CHROMA_DB_PATH=./chroma_db
# GENERIC_CHROMA_COLLECTION=documents

# Модели — витринный дефолт: openrouter / deepseek/deepseek-v4.1-flash на обоих
# путях (simple выбран по eval/runs/object_profile_traps_2026-09-17/summary.md).
# Для OSS-дефолта на OpenAI задайте SIMPLE_LLM_PROVIDER=openai / gpt-4o-mini.
# SIMPLE_LLM_PROVIDER=openrouter
# SIMPLE_MODEL_NAME=deepseek/deepseek-v4.1-flash
# COMPLEX_LLM_PROVIDER=openrouter
# COMPLEX_MODEL_NAME=deepseek/deepseek-v4.1-flash
# OpenRouter: нативные ручки (thinking_budget до OpenRouter не доходит).
# Дефолт effort=low; high = поведение провайдера DeepSeek. MAX_TOKENS/SORT: пусто = не отправлять.
# OPENROUTER_REASONING_EFFORT=low      # none|minimal|low|medium|high|xhigh|max
# OPENROUTER_MAX_TOKENS=2000           # reasoning тоже считается в этот лимит
# OPENROUTER_PROVIDER_SORT=latency     # latency|throughput|price
# RERANKER_BACKEND=crossencoder

# Department scoped retrieval: общий deadline включает очередь и reranker.
# DEPARTMENT_RETRIEVAL_TIMEOUT_S=120
# DEPARTMENT_RETRIEVAL_WORKERS=4
# DEPARTMENT_RETRIEVAL_PENDING=8

# Судья offline-eval — независим от пайплайна (по умолчанию openai / gpt-4o).
# JUDGE_LLM_PROVIDER=openai
# JUDGE_MODEL_NAME=gpt-4o

# -------------------------------------------------------------------
# LangSmith (опционально)
# -------------------------------------------------------------------
# LANGSMITH_API_KEY=YOUR_LANGSMITH_KEY_HERE
# LANGSMITH_TRACING_V2=true
# LANGSMITH_PROJECT=regulatory-rag

# -------------------------------------------------------------------
# V7/V8 config overrides (по умолчанию в src/v7/config.py, префикс V7_)
# -------------------------------------------------------------------
# V7_DOMAIN_GATE_THRESHOLD=0.25
# Потолок итоговой выдачи complex-ветки — столько чанков видит генератор
# V7_FINAL_MERGE_TOP_K=24
# V7_V8_ENABLE_MULTI_QUERY=true
# V7_V8_EXPAND_N=3

# -------------------------------------------------------------------
# Мониторинг (модуль 05)
# -------------------------------------------------------------------
# Выключить телеметрию целиком: граф работает, событий не пишется.
# V7_TELEMETRY_ENABLED=false
# Куда пишутся события: jsonl (по умолчанию, стек не нужен) или postgres (issue #23).
# V7_TELEMETRY_WRITER=jsonl
# Журнал для writer=jsonl; он же fallback, если postgres настроен неверно.
# V7_TELEMETRY_JSONL_PATH=logs/events.jsonl
# Пусто → DSN собирается из POSTGRES_* ниже. Задавать только для внешней базы.
# V7_TELEMETRY_PG_DSN=postgresql://user:pass@host:5432/db

# Стек мониторинга (docker compose up -d). Значения ниже небоевые —
# порты слушают только localhost, наружу стек не смотрит.
POSTGRES_USER=regrag
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=regrag
# Порты хоста, если 5432/3000 заняты.
# POSTGRES_PORT=5432
# GRAFANA_PORT=3000

# Вход в Grafana на localhost:3000.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-local-only
