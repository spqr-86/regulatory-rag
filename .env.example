# ===================================================================
# Конфигурация для Regulatory RAG
# ===================================================================
# Скопируйте этот файл в .env и заполните своими ключами

# -------------------------------------------------------------------
# API Keys (секреты — не коммитить)
# -------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE       # https://aistudio.google.com/apikey
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE           # https://platform.openai.com/api-keys (для эмбеддингов)

# -------------------------------------------------------------------
# Per-path model config
# Меняй независимо: SIMPLE_LLM_PROVIDER=deepseek + SIMPLE_MODEL_NAME=deepseek-chat
# -------------------------------------------------------------------
SIMPLE_LLM_PROVIDER=gemini
SIMPLE_MODEL_NAME=gemini-2.5-flash
COMPLEX_LLM_PROVIDER=gemini
COMPLEX_MODEL_NAME=gemini-3-flash-preview

# -------------------------------------------------------------------
# Embeddings
# -------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small

# -------------------------------------------------------------------
# Vector store
# -------------------------------------------------------------------
CHROMA_DB_PATH=./chroma_db_gemini
CHROMA_COLLECTION_NAME=documents
VECTOR_STORE=chroma
VECTOR_SEARCH_K=40

# -------------------------------------------------------------------
# Indexing
# -------------------------------------------------------------------
SOURCE_DOCS_PATH=./source_docs
CHUNK_SIZE=1500
CHUNK_OVERLAP=400

# -------------------------------------------------------------------
# Misc
# -------------------------------------------------------------------
TEMPERATURE=0.0
REQUEST_TIMEOUT=120.0

# LangSmith (eval и трассировка — опционально)
# LANGSMITH_API_KEY=YOUR_LANGSMITH_KEY_HERE
# LANGSMITH_TRACING_V2=true
# LANGSMITH_PROJECT=regulatory-rag

# V7 graph
USE_V7_GRAPH=true
